# Environment for EVERY zsh invocation: interactive, login, scripts, cron, and
# `ssh host cmd`. Anything a non-interactive tool needs to see belongs here
# rather than in .zshrc, which only interactive shells read.
#
# No output, no interactive-only assumptions - see the note in zshenv-bootstrap.

# Keep PATH/FPATH entries unique. zsh ties the `path` array to $PATH, so this
# makes re-sourcing (tmux, nested shells) idempotent without any manual guard.
typeset -U path fpath

# Homebrew's prefix differs by platform: /opt/homebrew on Apple Silicon,
# /usr/local on Intel macOS, /home/linuxbrew on Linux. Probe rather than assume.
#
# This must run for EVERY invocation, not just login shells. rc.d guards its
# tool integrations on `command -v fzf` and similar, so a shell that has not
# seen the brew prefix silently loses those features rather than erroring.
# `typeset -U path` above makes the repeated prepend idempotent when shells
# nest (tmux inside ssh, and so on).
for brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [[ -x "$brew_prefix/bin/brew" ]]; then
    eval "$("$brew_prefix/bin/brew" shellenv)"
    break
  fi
done
unset brew_prefix

# Userspace scripts deployed by install.sh from the repo's bin/ directory,
# alongside pipx/uv shims that install here by default. Prepended AFTER the
# brew shellenv above so these win over anything with the same name in the
# brew prefix.
path=("$HOME/.local/bin" $path)

export EDITOR="vim"
export VISUAL="$EDITOR"

# Suppress .pyc/__pycache__ writes. Set here rather than in .zshrc so it also
# applies to `ssh host 'python ...'`, cron jobs, and editor subshells.
export PYTHONDONTWRITEBYTECODE=1

# Host-specific env that should not be committed - YARA_AUTHOR, tokens, work
# paths - goes in this untracked file. Sourced here rather than from .zshrc so
# GUI apps and non-interactive shells see it too.
[[ -f "${ZDOTDIR:-$HOME}/zshenv.local" ]] && source "${ZDOTDIR:-$HOME}/zshenv.local"
